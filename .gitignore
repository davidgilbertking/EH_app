# Local media (music & character art) — kept out of the public repo.
# Folders themselves are preserved via .gitkeep so artisan / npm scripts
# don't fail on first clone.
/storage/app/private/audio/*
!/storage/app/private/audio/.gitkeep
/storage/app/public/ancients/*
!/storage/app/public/ancients/.gitkeep
!/storage/app/public/ancients/bg/
/storage/app/public/ancients/bg/*
!/storage/app/public/ancients/bg/.gitkeep
/storage/app/public/investigators/*
!/storage/app/public/investigators/.gitkeep
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Private lighting diagnostics and TinyTuya credentials/snapshots.
# An ignore rule does not remove an already tracked file from Git history.
/cookies.txt
devices.json
tinytuya.json
tuya-raw.json
snapshot.json
/lighting-diagnostics/
/storage/app/private/lighting/
/storage/framework/lighting-sender.lock
/storage/framework/lighting-sender-*.lock
/storage/framework/lighting-worker-*.lock
/scripts/lighting/**/__pycache__/
