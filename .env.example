APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

EH_AUDIO_LOUDNESS_TARGET_LUFS=-18
EH_AUDIO_LOUDNESS_PEAK_CEILING_DBTP=-1
EH_AUDIO_LOUDNESS_MAX_BOOST_DB=12
EH_AUDIO_LOUDNESS_MAX_CUT_DB=24
EH_AUDIO_LOUDNESS_ANALYSIS_TIMEOUT_SEC=180

# Start the separate executor with: php artisan lighting:work
# Keep mock until the selected physical driver has been commissioned.
LIGHTING_DRIVER=mock
# Cloud credentials and captured lamp profiles stay outside Git.
# LIGHTING_CLOUD_DEVICE_ID=
# LIGHTING_CLOUD_CREDENTIALS_FILE=/absolute/private/path/cloud-credentials.json
# LIGHTING_CLOUD_PRIVATE_DIRECTORY=/absolute/private/path/lighting
# Continuous channel fades keep the lamp ON; enable for a commissioned Cloud lamp.
LIGHTING_CLOUD_CONTINUOUS_TRANSITIONS=false
# Local candidate within continuous mode: onboard down/RGB fades, then hold.
# Raw firmware timing is NOT milliseconds; calibrate visually on the lamp.
LIGHTING_CLOUD_ONBOARD_FADES=false
LIGHTING_CLOUD_NATIVE_FADE_TIMING_BYTE=30
LIGHTING_CLOUD_NATIVE_FADE_WAIT_MS=5000
# Enable only after the selected lamp's native transitions are verified.
LIGHTING_CLOUD_NATIVE_TRANSITIONS=false
# Separately verified interruption of a native white rise.
LIGHTING_CLOUD_NATIVE_INTERRUPTS=false
# Full white fade duration, in milliseconds: 3000 = 3s, 5000 = 5s.
LIGHTING_WHITE_FADE_MS=4000
# Independent white overrides (if omitted, use LIGHTING_WHITE_FADE_MS).
# White dimming on Mythos / ordinary white rise:
LIGHTING_WHITE_FADE_DOWN_MS=5000
LIGHTING_WHITE_FADE_UP_MS=1250
# RGB dimming on exit / RGB rise after selecting a color:
LIGHTING_SCENE_FADE_OUT_MS=2000
LIGHTING_SCENE_FADE_IN_MS=5000
# After changing timings, clear any config cache and restart lighting:work.
LIGHTING_DARK_HOLD_MS=150
LIGHTING_CURVE=smoothstep
LIGHTING_TICK_MS=100
LIGHTING_CONTROL_LEASE_MS=43200000
LIGHTING_MOCK_DELAY_MS=0
# Optional failure injection: offline or transport_timeout
LIGHTING_MOCK_FAILURE=
